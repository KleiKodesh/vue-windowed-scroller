{
  "name": "vue-windowed-scroller",
  "version": "0.1.0",
  "description": "A Vue 3 windowed list for long, variable-height content: real flow rows (no estimated positions), exact jumps, a scrollbar for the whole list, and a row source that may be slow or fail.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KleiKodesh/vue-windowed-scroller.git"
  },
  "homepage": "https://github.com/KleiKodesh/vue-windowed-scroller#readme",
  "bugs": "https://github.com/KleiKodesh/vue-windowed-scroller/issues",
  "keywords": [
    "vue",
    "vue3",
    "virtual-scroll",
    "virtual-list",
    "windowing",
    "infinite-scroll",
    "scroller",
    "variable-height"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node e2e/run.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@vueuse/core": "^10.0.0 || ^11.0.0 || ^12.0.0 || ^13.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vueuse/core": "^10.11.1",
    "playwright": "^1.59.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.9",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.1"
  }
}
